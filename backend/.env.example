# Local example. Any Ollama chat model + Ollama embedding model can be selected.
# On DGX, for example, use qwen3.5:35b and qwen3-embedding:8b-q8_0.
# Restart after edits. Embedding changes also require running train_engine.py.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
OLLAMA_KEEP_ALIVE=1800
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=768
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
# auto inspects model capabilities; explicit values: false, true, default, or an effort level.
OLLAMA_THINK=auto
QA_RESPONSE_TIMEOUT_SECONDS=180
QA_REASONING_ENABLED=false
ASSISTANT_NAME=Khoj
ASSISTANT_PERSONA=a calm, perceptive colleague who explains difficult material in plain language
QA_TEMPERATURE=0.3
QA_WARMUP_ON_STARTUP=false
QA_API_URL=http://localhost:8000
BACKEND_CALL_MODE=inprocess
TEXMIN_HOST=localhost
OFFLINE_MODE=true
STT_ENGINE=faster-whisper
WHISPER_MODEL=small
WHISPER_TRANSFORMERS_MODEL=openai/whisper-small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_MODEL_DIR=models/whisper
WHISPER_BEAM_SIZE=1
WHISPER_WORKERS=2
STT_MAX_CONCURRENT=1
WHISPER_VAD_SILENCE_MS=350
STT_WARMUP_ON_STARTUP=false
# CPU speech: two pre-downloaded ONNX files, no reference audio or HF token.
TTS_ENGINE=piper
PIPER_HINDI_VOICE=hi_IN-pratham-medium
PIPER_ENGLISH_VOICE=en_US-lessac-medium
# Optional PIPER_MODEL_DIR: defaults to backend/models/piper; Compose uses /models/piper.
TTS_TIMEOUT_SECONDS=45
TTS_RESPONSE_TIMEOUT_SECONDS=120
RESPONSE_LANGUAGE=hinglish
HINGLISH_SCRIPT=mixed
TTS_FALLBACK_ENGINES=espeak
TTS_TONE=warm
TTS_STREAM_MIN_CHARS=160
TTS_FAILURE_THRESHOLD=2
TTS_FAILURE_COOLDOWN_SECONDS=60
EDGE_TTS_VOICE=en-IN-NeerjaNeural
EDGE_TTS_HINDI_VOICE=hi-IN-SwaraNeural
EDGE_TTS_TONE=neutral
EDGE_TTS_RATE=+0%
EDGE_TTS_PITCH=+0Hz
AVATAR_MODEL_FILE=assets/scene.gltf
CHROMA_COLLECTION_NAME=texmin_qa
RAW_DATA_DIR=raw_data_files
VECTOR_DB_DIR=vector_db
CHUNK_SIZE=850
CHUNK_OVERLAP=150
EMBEDDING_BATCH_SIZE=32
INGESTION_WORKERS=4
FAST_FILE_CHECK=true
MIN_EXTRACTED_TEXT_CHARS=80
RETRIEVAL_FETCH_K=40
RETRIEVAL_MMR_ENABLED=true
HYBRID_SEARCH_ENABLED=true
HYBRID_RRF_K=60
ALLOW_LOW_RELEVANCE_FALLBACK=true
# Optional reranker uses Qwen3's yes/no protocol; keep disabled for lightweight local use.
RERANK_ENABLED=false
RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANK_CANDIDATES=12
RERANK_MAX_LENGTH=1024
RELEVANCE_SCORE_THRESHOLD=0.15
MIN_RETRIEVED_TEXT_CHARS=40
MMR_LAMBDA_MULT=0.35
SUMMARY_CONTEXT_CHUNKS=14
SUMMARY_FETCH_K=80
SUMMARY_MMR_LAMBDA_MULT=0.2
CONTEXT_MAX_CHARS=6000
